{
  "name": "@choi-p/dsh-deepseek-balance",
  "version": "0.3.4",
  "description": "DeepSeek account balance in the dsh web sidebar footer, with live config hot reload and an editable Settings → Plugins card.",
  "license": "MIT",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "plugin",
    "balance"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Choi-Peng/dsh-deepseek-balance.git"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-include": "^1.0.6",
    "js-yaml": "^4.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "immediately": false
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ]
}
